# Copy to .env for local development (never commit the real .env).
# Get this from Coolify: your Postgres resource → Connection details.
# Use the internal hostname when connecting from another Coolify service
# on the same network; use the external/public URL from your laptop.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated list of frontend origins allowed to call the API,
# e.g. https://schedule.adamrmunday.com
CORS_ORIGINS=

# Password for the dashboard's "Refresh data" button (rebuilds all data from
# the raw CSVs in THIS server's data/raw/). Leave UNSET to disable refresh
# entirely — recommended on production, where data is loaded from
# data/processed/ instead (see README). Set any value locally to use it.
ADMIN_TOKEN=
